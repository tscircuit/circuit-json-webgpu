{
  "name": "circuit-json-webgpu",
  "version": "0.0.1",
  "description": "Retained WebGPU renderer for Circuit JSON PCB geometry",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "github:tscircuit/circuit-json-webgpu",
  "license": "MIT",
  "scripts": {
    "build": "tsup lib/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/geometry.test.ts",
    "test:visual": "node tests/visual.mjs",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 node tests/visual.mjs",
    "dev": "vite --host 127.0.0.1",
    "prepare": "bun run build",
    "format": "biome format lib site tests/geometry.test.ts tests/visual.mjs --write",
    "format:check": "biome format lib site tests/geometry.test.ts tests/visual.mjs"
  },
  "dependencies": {
    "@tscircuit/alphabet": "^0.0.25",
    "earcut": "^3.0.2"
  },
  "peerDependencies": {
    "circuit-json": ">=0.0.469"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.3.0",
    "@types/earcut": "^3.0.0",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.64",
    "circuit-json": "^0.0.469",
    "pixelmatch": "^7.1.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
