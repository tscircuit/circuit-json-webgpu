{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "lib/*": [
        "./lib/*"
      ],
      "tests/*": [
        "./tests/*"
      ]
    }
  },
  "include": [
    "lib",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "site",
    "scripts"
  ],
  "exclude": [
    "tests/upstream/**",
    "tests/parity/capture.ts"
  ]
}
